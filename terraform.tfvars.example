vm_name           = "rocky-vm"
vm_memory         = "4096"
vm_vcpu           = 2
vm_disk_size      = 21474836480 # 20GB
user_name         = "yourusername"
source_image      = "https://dl.rockylinux.org/pub/rocky/10/images/x86_64/Rocky-10-GenericCloud-Base.latest.x86_64.qcow2"
domains_path      = "/mnt/user/domains/tofu"
isos_path         = "/mnt/user/isos/tofu"
ssh_public_key    = "~/.ssh/id_ed25519.pub"
network_interface = "br0"
network_subnet    = "192.168.1.0/24"
uri               = "qemu+ssh://root@unraid/system?sshauth=privkey&keyfile=/home/yourhomedir/.ssh/id_ed25519&no_verify=1"
