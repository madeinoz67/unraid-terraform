fqdn: ${vm_name}.lan
# fqdn's first label becomes the hostname; manage_etc_hosts writes
# "127.0.0.1 rocky-01.lan rocky-01", which resolves the name cleanly.
manage_etc_hosts: true
prefer_fqdn_over_hostname: true
users:
  - name: ${user_name}
    sudo: ALL=(ALL) NOPASSWD:ALL
    groups: [wheel]
    home: /home/${user_name}
    shell: /bin/bash
    lock_passwd: true
    ssh_authorized_keys:
      - ${ssh_public_key}
ssh_pwauth: false
disable_root: true
package_update: true
package_upgrade: true
packages:
  - qemu-guest-agent
runcmd:
  - systemctl enable --now qemu-guest-agent
